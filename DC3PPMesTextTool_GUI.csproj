    <Version>1.2.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Da Capo 3 Platinum Partner MES Text Tool</Product>
    <Description>MES and JSON converter for Da Capo 3 Platinum Partner</Description>
    <RootNamespace>DC3PPMesTextTool_GUI</RootNamespace>
